[Unit]
Description=Gymflex Telegram bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/gymfl3x
EnvironmentFile=/root/gymfl3x/.env
ExecStart=/root/gymfl3x/app/venv/bin/python -m app.main
Restart=always
RestartSec=5
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gymflex

[Install]
WantedBy=multi-user.target
