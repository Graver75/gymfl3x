BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
ADMIN_TELEGRAM_IDS=123456789
TIMEZONE=Europe/Moscow
# Local (venv): relative to project root
DATABASE_URL=sqlite+aiosqlite:///./gymflex.db
# Docker Compose overrides these to /data/... — you can leave local values in .env
REMINDER_HOUR=8
RECAP_HOUR=22
LOG_LEVEL=INFO
LOG_FILE=logs/gymflex.log
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5

# Remote LLM coach (no local Ollama required)
NN_ENABLED=true
NN_TIMEOUT_SEC=60
NN_HEALTH_TIMEOUT_SEC=5
# Default if admin has not switched in UI: gemini | deepseek | qwen
COACH_PROVIDER=gemini
COACH_PROFILE_ENABLED=false
COACH_LIVE_COOLDOWN_SEC=90

# Soft limits for admin display / soft-block (bot-side counters)
GEMINI_RPD_LIMIT=1000
GEMINI_RPM_LIMIT=15

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen via DashScope compatible mode (OpenAI-compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash

# Legacy local nn service (unused when remote keys are set)
# NN_URL=http://nn:8000
