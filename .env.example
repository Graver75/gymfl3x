BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
ADMIN_TELEGRAM_IDS=123456789
TIMEZONE=Europe/Moscow
# Local (venv): relative to project root
DATABASE_URL=sqlite+aiosqlite:///./gymflex.db
# Docker Compose overrides these to /data/... — you can leave local values in .env
REMINDER_HOUR=8
RECAP_HOUR=22
LOG_LEVEL=INFO
LOG_FILE=logs/gymflex.log
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5

# Optional LLM coach (services nn + ollama, compose profile "nn")
NN_URL=http://nn:8000
NN_ENABLED=true
NN_TIMEOUT_SEC=120
NN_HEALTH_TIMEOUT_SEC=3
# OLLAMA_MODEL=qwen2.5:1.5b-instruct
